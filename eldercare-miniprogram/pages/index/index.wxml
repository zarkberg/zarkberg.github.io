<view class="page">
  <view class="hero">
    <view class="brand">专利雷达 <text>· 技术机会助手</text></view>
    <view class="subtitle">从一个技术痛点，找到下一步</view>
    <button class="market-entry" bindtap="openMarket">农产品商情匹配测试</button>
    <view class="input-box">
      <input class="problem-input" value="{{problem}}" bindinput="onInput" placeholder="例如：想做老人跌倒检测设备" />
    </view>
    <button class="primary-button" loading="{{loading}}" bindtap="analyze">{{loading ? "正在分析..." : "开始分析"}}</button>
    <scroll-view class="quick-list" scroll-x>
      <view class="quick-item" data-value="想做一种适合老年人的居家跌倒检测设备，降低误报并保护隐私" bindtap="useExample">老人跌倒检测</view>
      <view class="quick-item" data-value="想做低成本的家庭储能电池低温保温方案" bindtap="useExample">低温储能</view>
      <view class="quick-item" data-value="想做能提升室内机器人定位精度的传感器方案" bindtap="useExample">机器人定位</view>
    </scroll-view>
  </view>

  <block wx:if="{{analyzed}}">
    <view class="section">
      <view class="section-title">① 痛点已拆解 <text class="tag tag-green">可检索</text></view>
      <view class="muted">系统已提取对象、场景、问题和目标，并扩展检索词。</view>
      <view class="tags">
        <text class="tag">智能养老设备</text>
        <text class="tag">居家场景</text>
        <text class="tag">跌倒检测</text>
        <text class="tag">隐私保护</text>
        <text class="tag">降低误报</text>
      </view>
      <view class="muted" style="margin-top: 18rpx">推荐技术词：毫米波雷达 · 视觉识别 · 可穿戴传感器 · 多模态融合 · 边缘计算</view>
    </view>

    <view class="section">
      <view class="section-title">② 一页结论 <text class="tag">初筛结果</text></view>
      <view class="metrics">
        <view class="metric">技术热度<text class="metric-value">高</text></view>
        <view class="metric">竞争程度<text class="metric-value">中</text></view>
        <view class="metric">专利族<text class="metric-value">86</text></view>
        <view class="metric">近3年趋势<text class="metric-value">+28%</text></view>
      </view>
    </view>

    <view class="section">
      <view class="section-title">技术路线图 <text class="muted">公开样例数据</text></view>
      <view class="route"><view class="route-head"><text>毫米波雷达检测</text><text class="tag tag-green">增长快</text></view><view class="route-meta">相关专利 26 · 近三年增长 41% · 竞争中</view></view>
      <view class="route"><view class="route-head"><text>视觉识别检测</text><text class="tag">竞争高</text></view><view class="route-meta">相关专利 43 · 近三年增长 19% · 申请人集中</view></view>
      <view class="route"><view class="route-head"><text>多传感器融合 + 边缘计算</text><text class="tag tag-green">可切入</text></view><view class="route-meta">相关专利 18 · 近三年增长 36% · 竞争分散</view></view>
    </view>

    <view class="section">
      <view class="section-title">代表专利 <text class="muted">3 条</text></view>
      <view class="patent"><view class="patent-title">一种基于毫米波雷达的居家跌倒检测方法及系统</view><view class="patent-meta">公开日 2024-06 · 某智能科技有限公司 · G08B 21/04</view></view>
      <view class="patent"><view class="patent-title">基于多模态感知的老年人异常行为识别装置</view><view class="patent-meta">公开日 2023-11 · 某大学 · G06V 40/20</view></view>
      <view class="patent"><view class="patent-title">保护隐私的室内跌倒监测边缘计算设备</view><view class="patent-meta">公开日 2025-02 · 某健康科技企业 · G06F 21/62</view></view>
    </view>

    <view class="section">
      <view class="section-title">机会与风险 <text class="tag tag-green">建议行动</text></view>
      <view class="muted">机会：多传感器融合降低误报；本地边缘推理保护隐私；优先与社区养老、物业和护理机构试点。</view>
      <view class="muted" style="margin-top: 16rpx">风险：视觉识别方向申请人较集中，需进一步比对权利要求。本页不构成侵权或可专利性结论。</view>
    </view>

    <view class="section">
      <view class="locked">
        <view class="section-title">深度机会报告</view>
        <view class="muted">完整路线、申请人竞争矩阵、专利证据链和专家/机构线索</view>
        <view class="price">9.9 元</view>
        <button class="primary-button" bindtap="unlock">模拟支付并解锁</button>
      </view>
      <view wx:if="{{unlocked}}" class="locked" style="margin-top: 18rpx">
        <view class="section-title">付费咨询已解锁</view>
        <view class="muted">可提交技术路线、专利风险、院所合作或专家团队咨询。</view>
        <button class="primary-button" bindtap="consult">提交咨询留言</button>
      </view>
    </view>
  </block>

  <view wx:if="{{analyzed}}" class="bottom-bar">
    <button class="bottom-button" bindtap="save">收藏方向</button>
    <button class="bottom-button primary" bindtap="downloadReport">生成报告</button>
    <button class="bottom-button" bindtap="share">分享</button>
  </view>
</view>
