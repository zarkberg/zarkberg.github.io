.market-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
  background: #f3f6fb;
}

.market-hero {
  padding: 42rpx 32rpx 36rpx;
  color: #fff;
  background: linear-gradient(120deg, #102a67, #1761ca 62%, #0ea5e9);
}

.market-title {
  font-size: 44rpx;
  font-weight: 700;
}

.market-subtitle {
  margin-top: 12rpx;
  color: #dbeafe;
  font-size: 25rpx;
}

.market-section {
  margin: 24rpx;
  padding: 28rpx;
  background: #fff;
  border: 1rpx solid #e5eaf2;
  border-radius: 18rpx;
}

.mode-tabs {
  display: flex;
  gap: 16rpx;
}

.mode {
  flex: 1;
  color: #2563eb;
  background: #eef4ff;
  font-size: 28rpx;
}

.mode.active {
  color: #fff;
  background: #2563eb;
}

.hint {
  margin-top: 14rpx;
  color: #64748b;
  font-size: 24rpx;
}

.message-input {
  width: 100%;
  min-height: 150rpx;
  margin-top: 18rpx;
  padding: 18rpx;
  background: #f8fafc;
  border: 1rpx solid #e5eaf2;
  border-radius: 12rpx;
}

.secondary-button {
  margin: 18rpx 0 0;
  color: #2563eb;
  background: #eef4ff;
}

.parsed-box, .share-card {
  margin-top: 18rpx;
  padding: 18rpx;
  background: #f0fdf8;
  border: 1rpx solid #bbf7d0;
  border-radius: 12rpx;
}

.parsed-title, .success-title {
  color: #0f9f6e;
  font-weight: 700;
}

.field-row, .form-row {
  display: flex;
  align-items: center;
  min-height: 74rpx;
  border-bottom: 1rpx solid #eef2f7;
}

.field-row {
  justify-content: space-between;
}

.field-row:last-child, .form-row:last-child {
  border-bottom: 0;
}

.label {
  width: 190rpx;
  color: #64748b;
  font-size: 25rpx;
}

.form-row input {
  flex: 1;
  padding: 12rpx 0;
  font-size: 27rpx;
}

.market-button {
  margin-top: 24rpx;
  color: #fff;
  background: #2563eb;
}

.picker-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  color: #172033;
  border-bottom: 1rpx solid #eef2f7;
}

.picker-row text {
  color: #2563eb;
}

.source-input {
  width: 100%;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #eef2f7;
  font-size: 27rpx;
}

.consent {
  display: block;
  margin-top: 18rpx;
  color: #172033;
  font-size: 24rpx;
}

.owner-section {
  background: linear-gradient(135deg, #f7fbff, #f0fdf8);
}

.invite-code {
  margin-top: 14rpx;
  color: #0f9f6e;
  font-size: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
}

.share-title {
  font-size: 30rpx;
  font-weight: 700;
}

.match-card {
  margin-top: 16rpx;
  padding: 18rpx;
  border: 1rpx solid #e5eaf2;
  border-radius: 12rpx;
}

.match-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-weight: 700;
}

.score {
  color: #0f9f6e;
  font-size: 24rpx;
}

.trust-row {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 22rpx;
}

.contact-button {
  margin: 14rpx 0 0;
  color: #2563eb;
  background: #eef4ff;
  font-size: 25rpx;
}
